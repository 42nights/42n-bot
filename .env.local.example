# Required
ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=ghp_...                          # fine-grained PAT with issues + PR write
GITHUB_WEBHOOK_SECRET=...                     # shared secret with the GitHub App / webhook
OPENAI_API_KEY=sk-proj-...                    # embeddings (reviewer dedupe + chat corpus)
OTIS_ADMIN_SECRET=...                         # shared secret gating mutating /api routes for non-browser callers (crons, CLI)
OTIS_SERVER_SECRET=...                        # token the Next server presents to Convex to read GitHub App secrets; ALSO set this in the Convex dashboard env

# Optional
CLAUDE_CODE_PATH=claude                       # binary name or absolute path
DASHBOARD_URL=http://localhost:3000           # used in PR bodies as deep links
REPO_DIR=                                     # path to the main checkout the worktrees branch from
WORKTREE_ROOT=                                # parent dir for bot worktrees; default = ../.42n-bot-worktrees
DEMO_MODE=1                                   # seeds & serves the demo dataset; disables real GH calls
