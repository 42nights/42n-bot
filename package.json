{
  "name": "42n-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "build:bot": "node scripts/build-bot.mjs",
    "watch:bot": "node scripts/build-bot.mjs --watch",
    "seed:demo": "node --env-file=.env.local --import tsx scripts/seed-demo.ts",
    "bot": "npm run build:bot && node --env-file=.env.local dist/src/coordinator/index.js",
    "smoke": "npm run build:bot && node --env-file=.env.local dist/scripts/smoke-test.js",
    "go": "concurrently --kill-others --names dash,bot --prefix-colors blue,magenta \"npm:dev\" \"npm:bot\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/rest": "^21.0.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.2",
    "@types/canvas-confetti": "^1.9.0",
    "better-sqlite3": "^11.7.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^7.0.0",
    "execa": "^9.6.1",
    "geist": "^1.7.1",
    "lucide-react": "^0.460.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "sonner": "^1.7.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
